# Production settings. Copy to .env on the server and fill in the blanks (see docs/deploying.md).
# Never commit the filled-in copy. Values marked CHANGE ME must be changed.

APP_NAME="Turnkeeper"
APP_ENV=production
# Generate on the server with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# The real https address. Every link (emails, invites) is built from it.
APP_URL=https://theturnkeeper.app

# Leave empty with deploy/server: Caddy hands requests to PHP directly, with the visitor's real address
# and https, so no X-Forwarded-* headers should be believed (a visitor could fake them to dodge rate
# limits). Only set it if a separate proxy or load balancer forwards to the app: list its address.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=turnkeeper
DB_USERNAME=turnkeeper
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over https.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
FILESYSTEM_DISK=local
# Nothing is queued yet (broadcasts and emails go straight away), so no worker is needed.
QUEUE_CONNECTION=sync

# --- Email (verification and password resets) ---
# Any SMTP provider works. For Resend: host smtp.resend.com, username "resend", password = an API key.
# Port 587 (STARTTLS): Hetzner blocks outgoing 25 and 465 on new servers, so those would silently fail.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CHANGE-ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD=CHANGE-ME
# An address on your own domain, set up with the provider (SPF/DKIM), so emails don't land in spam.
MAIL_FROM_ADDRESS="hello@theturnkeeper.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Live player view (Reverb) ---
# The app talks to Reverb on the server itself; browsers reach it through the proxy at wss://APP_URL/app.
BROADCAST_CONNECTION=reverb
# Generate random values, e.g. with: php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
REVERB_APP_ID=CHANGE-ME
REVERB_APP_KEY=CHANGE-ME
REVERB_APP_SECRET=CHANGE-ME
# Where the app sends broadcasts: Reverb itself, inside the server (or its container name).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Only on the server itself; browsers come in through Caddy.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Where browsers connect. These are built into the JavaScript, so set them before `npm run build`.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=theturnkeeper.app
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- Feedback, privacy and errors ---
# Where "Send feedback" (footer and account menu) goes: a form, or mailto:you@example.com.
# Leave empty to have it email CONTACT_EMAIL instead.
FEEDBACK_URL=
# Shown on /privacy for questions about personal data, and used for feedback. Defaults to MAIL_FROM_ADDRESS.
CONTACT_EMAIL=
# Accounts that can open the admin page (/admin), comma-separated. Their emails must be verified.
ADMIN_EMAILS=
# From your Sentry project (Settings → Client Keys). Leave empty to switch error reporting off.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
