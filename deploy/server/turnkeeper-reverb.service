# Keeps Reverb (the live player view's websockets) running. setup.sh fills in the {{…}} values and
# installs it as /etc/systemd/system/turnkeeper-reverb.service. `php artisan reverb:restart` makes it
# stop after a deploy; Restart=always starts it again on the new code.
[Unit]
Description=Turnkeeper Reverb (live player view)
After=network.target postgresql.service

[Service]
User={{APP_USER}}
WorkingDirectory={{APP_DIR}}
# Only on the server itself: browsers reach it through Caddy.
ExecStart=/usr/bin/php{{PHP}} artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
